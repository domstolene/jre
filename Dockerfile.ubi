# Get Java Runtime Environment 25 using regular UBI image
FROM registry.access.redhat.com/ubi10 AS builder

# Docker automatically injects TARGETARCH (e.g., "amd64" or "arm64")
ARG TARGETARCH
ARG JAVA_VERSION=25

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

# Download JRE from Eclipse Temurin project
ADD src /build
RUN /build/install-java.sh $TARGETARCH $JAVA_VERSION

# Copy only JRE into micro image
FROM registry.access.redhat.com/ubi10-micro

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

COPY --from=builder /opt/java/openjdk /opt/java/openjdk

ENTRYPOINT ["java"]
CMD ["-version"]
